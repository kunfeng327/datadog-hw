# 复制为 frontend/.env.local 并填入你自己的值（.env.local 已被 git 忽略，不会提交密钥）
# 来源：Datadog 控制台 -> Organization Settings -> RUM Applications -> New Application

VITE_DD_RUM_APP_ID=你的-application-id
VITE_DD_RUM_CLIENT_TOKEN=你的-client-token

# 站点根据账号选择（US1 默认）：datadoghq.com / us5.datadoghq.com / eu.datadoghq.com / ap1.datadoghq.com
VITE_DD_SITE=datadoghq.com
VITE_DD_ENV=dev

# 后端地址（默认即可）
# VITE_API_BASE_URL=http://localhost:9000
