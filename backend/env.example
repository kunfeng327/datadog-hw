# Datadog 后端配置示例（Windows PowerShell 用 $env: 设置，见 README）
# 来源：Datadog 控制台 -> Organization Settings -> API Keys

# 服务名和环境（会打在每条 trace / metric / log 上）
DD_SERVICE=rock-demo-api
DD_ENV=dev
DD_VERSION=0.2.0

# Agent 地址（本机默认 127.0.0.1；APM 8126 / DogStatsD 8125）
# DD_AGENT_HOST=127.0.0.1

# 直连模式（无 Agent 时通过 API Key 直接上报 traces/logs，配合 DD_API_KEY）
# DD_TRACE_AGENT_URL=https://trace.agent.datadoghq.com
# DD_LOGS_DIRECT_SUBMISSION_INSECURE_MODE=1
